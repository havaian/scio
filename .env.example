# Copy to .env (same folder as docker-compose.yml). .env is git-ignored.
# Jev (TypeSafe): AI triage and error-message grading. Optional.
TYPESAFE_API_KEY=
# QVAC local AI: build the image with the SDK, then enable it. Models go in ./models (npm run qvac:setup).
WITH_QVAC=false
# Headless Chromium for bank logins (build-time; about 300 MB). false = plain form filler only
WITH_BROWSER=true
QVAC_ENABLED=false
# Uptime monitor (one request per target every 5 min; monitor.realIntervalMin / simulatedIntervalMin in backend/config/thresholds.json).
MONITOR_ENABLED=true
# Automated audits at 09:00, 15:00 and 21:00 Tbilisi time, all targets each time (schedule.slots in backend/config/thresholds.json).
AUDIT_SCHEDULE_ENABLED=true

# Private key passwords of the bank sandbox test certificates (certs/<bank>/client.key). Empty if the key is not encrypted.
LIBERTY_CERT_PASSWORD=
SILK_CERT_PASSWORD=
CARTU_CERT_PASSWORD=
TBC_CERT_PASSWORD=
CREDO_CERT_PASSWORD=
# Credo sandbox OAuth client (token endpoint uses client_secret_basic)
CREDO_CLIENT_ID=
CREDO_CLIENT_SECRET=
# Bank of Georgia sandbox: PEM pass phrase of certs/bog/*.key; OAuth client ID if BoG issued one (else the TPP identifier in the certificate is used)
BOG_CERT_PASSWORD=
BOG_CLIENT_ID=
# Bank of Georgia sandbox test user's password (issued to the team; user BOG_OB_SBX is in targets.json)
BOG_PSU_PASSWORD=

# TBC BIS - Accounts test app (myapps.tbcbank.ge): client ID and secret. Read-only; transfers are never called.
TBC_BIS_CLIENT_ID=
TBC_BIS_CLIENT_SECRET=

# Alerts (all optional; off until a channel is set). Telegram: bot token from @BotFather and the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email over SMTP. SMTP_SECURE=true for port 465 (implicit TLS); empty = STARTTLS on 587. ALERT_EMAIL_TO is comma-separated.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL_TO=
# false turns alerts off even with channels set.
ALERTS_ENABLED=
# Dashboard link added to alert messages, e.g. https://scio.uz
PUBLIC_URL=
